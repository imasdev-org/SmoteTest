{
  "name": "smotetest-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Smoke test automatizado de la app nativa de Tienda Inglesa (Android + iOS) con Appium",
  "scripts": {
    "appium:drivers": "appium driver install uiautomator2 && appium driver install xcuitest",
    "appium:doctor": "appium driver doctor uiautomator2",
    "test:android": "wdio run ./wdio.android.conf.ts",
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "tiempos": "node scripts-tiempos.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@wdio/appium-service": "^10.0.1",
    "@wdio/cli": "^10.0.1",
    "@wdio/cucumber-framework": "^10.0.1",
    "@wdio/junit-reporter": "^10.0.1",
    "@wdio/local-runner": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "webdriverio": "^10.0.1"
  }
}